{
  "id": "ai-creative-canvas",
  "name": "ai-creative-canvas",
  "displayName": "AI 创意画布",
  "version": "0.9.0",
  "author": "mulby",
  "type": "ai",
  "description": "无限画布 AI 影像创作 + 可恢复创作 Agent：逐卡生成图像/视频/文本/配音，支持剧本转故事板、静帧、视频与时间线，并内置完整媒体编辑工具箱",
  "main": "dist/main.js",
  "ui": "ui/index.html",
  "icon": "icon.png",
  "assets": ["THIRD_PARTY_NOTICES.md"],
  "permissions": {
    "notification": true,
    "clipboard": true
  },
  "pluginSetting": {
    "single": true
  },
  "window": {
    "type": "default",
    "width": 1440,
    "height": 960,
    "minWidth": 1120,
    "minHeight": 720
  },
  "features": [
    {
      "code": "open-canvas",
      "explain": "打开 AI 创意画布（无限画布影像创作 + 媒体编辑）",
      "mode": "detached",
      "cmds": [
        { "type": "keyword", "value": "创意画布" },
        { "type": "keyword", "value": "无限画布" },
        { "type": "keyword", "value": "AI画布" },
        { "type": "img", "label": "在创意画布中打开图片", "exts": [".png", ".jpg", ".jpeg", ".webp", ".gif"] },
        { "type": "files", "label": "在创意画布中打开资源", "exts": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".avif", ".mp4", ".mov", ".webm", ".mp3", ".wav", ".aac", ".opus", ".m4a", ".flac", ".ogg", ".txt", ".md", ".json", ".srt", ".vtt"], "fileType": "file" }
      ]
    }
  ]
}
