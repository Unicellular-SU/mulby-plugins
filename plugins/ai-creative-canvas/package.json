    "test:persist": "esbuild test/persistence.test.ts --bundle --platform=node --format=esm --outfile=dist/persistence.test.mjs && node dist/persistence.test.mjs",
    "test:viewport": "esbuild test/viewport.test.ts --bundle --platform=node --format=esm --outfile=dist/viewport.test.mjs && node dist/viewport.test.mjs",
